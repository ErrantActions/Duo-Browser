# macOS local metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode and Swift build products
DerivedData/
[Bb]uild/
.build/
*.xcarchive/
*.ipa
*.dSYM/
*.dSYM.zip
*.hmap
*.profdata
*.profraw
*.xctestrun
